APP_NAME=Nature Saathi
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Ollama must be running locally before AI features can use these settings.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=240

# Optional: separate model for vision analysis (defaults to OLLAMA_MODEL if unset)
# OLLAMA_VISION_MODEL defaults to gemma3:4b when supported
OLLAMA_VISION_MODEL=gemma3:4b

# Evidence limits
MAX_IMAGE_SIZE_MB=10
MAX_REFLECTION_LENGTH=500
